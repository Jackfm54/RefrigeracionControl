
@model RefrigeracionControl.Web.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="dashboard-heading">
    <h2>Registrar empleado</h2>
    <p>Crear una cuenta interna para RefrigeracionControl.</p>
</div>

<div class="panel-card" style="max-width: 720px;">

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">
                Nombre completo
            </label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">
                Correo electrónico
            </label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Role" class="form-label">
                Rol
            </label>
            <select asp-for="Role" class="form-select">
                <option value="Tecnico">Técnico</option>
                <option value="Supervisor">Supervisor</option>
            </select>
            <span asp-validation-for="Role"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">
                Contraseña inicial
            </label>
            <input asp-for="Password"
                   class="form-control"
                   autocomplete="new-password" />
            <span asp-validation-for="Password"
                  class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword"
                   class="form-label">
                Confirmar contraseña
            </label>
            <input asp-for="ConfirmPassword"
                   class="form-control"
                   autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-info">
            Guardar usuario
        </button>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Cancelar
        </a>
    </form>
</div>
