
@model IEnumerable<RefrigeracionControl.Web.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="dashboard-heading">
    <h2>Administración de usuarios</h2>
    <p>Empleados, roles y control de acceso.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="panel-card">

    <div class="d-flex justify-content-between
                align-items-center mb-4">
        <h3 class="mb-0">Usuarios registrados</h3>

        <a asp-controller="Users"
           asp-action="Create"
           class="btn btn-info">
            + Nuevo usuario
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Role</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactivo
                                </span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive &&
                                 !user.IsAdministrator)
                            {
                                <form asp-action="Deactivate"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@user.Id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('¿Desactivar esta cuenta?')">
                                        Desactivar
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
