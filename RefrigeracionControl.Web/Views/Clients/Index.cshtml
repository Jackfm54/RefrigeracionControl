@model IEnumerable<RefrigeracionControl.Domain.Entities.Client>

@{
    ViewData["Title"] = "Clientes";
}

<div class="dashboard-heading">
    <h2>Clientes</h2>
    <p>Gestión de empresas y contactos.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="panel-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Listado de clientes</h3>
        <a asp-action="Create" class="btn btn-info">
            + Nuevo cliente
        </a>
    </div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
        <div class="col-md-6"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Nombre, contacto, ciudad, correo o teléfono" aria-label="Buscar clientes" /></div>
        <div class="col-md-3">
            <select name="status" class="form-select" aria-label="Estado">
                <option value="">Todos los estados</option>
                <option value="active" selected="@((string?)ViewData["Status"] == "active")">Activos</option>
                <option value="inactive" selected="@((string?)ViewData["Status"] == "inactive")">Inactivos</option>
            </select>
        </div>
        <div class="col-md-3"><button class="btn btn-info" type="submit">Buscar</button> <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
    </form>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Contacto</th>
                    <th>Teléfono</th>
                    <th>Ciudad</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in Model)
                {
                    <tr>
                        <td>@client.Name</td>
                        <td>@client.ContactName</td>
                        <td>@client.Phone</td>
                        <td>@client.City</td>
                        <td>
                            <span class="badge @(client.IsActive ? "bg-success" : "bg-secondary")">@(client.IsActive ? "Activo" : "Inactivo")</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-outline-info">Ver</a>
                            <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

@if (!Model.Any())
    {
        <div class="empty-state">
            No se encontraron clientes.
        </div>
    }
</div>