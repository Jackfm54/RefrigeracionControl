
@model RefrigeracionControl.Web.ViewModels.WorkOrderCreateViewModel

@{
    ViewData["Title"] = "Nueva orden";
}

<div class="dashboard-heading">
    <h2>Nueva orden de servicio</h2>
    <p>Registrar una intervención de refrigeración.</p>
</div>

<div class="panel-card" style="max-width: 800px;">

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label">
                Título del servicio
            </label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Descripción del trabajo
            </label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"></textarea>
            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ServiceType" class="form-label">
                Tipo de mantenimiento
            </label>
            <select asp-for="ServiceType" class="form-select">
                <option value="Preventivo">Preventivo</option>
                <option value="Correctivo">Correctivo</option>
            </select>
            <span asp-validation-for="ServiceType"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TechnicianId" class="form-label">
                Técnico responsable
            </label>
            <select asp-for="TechnicianId"
                    asp-items="Model.Technicians"
                    class="form-select">
                <option value="">Sin asignar</option>
            </select>
            <span asp-validation-for="TechnicianId"
                  class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-info">
                Guardar orden
            </button>
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>
        </div>
    </form>
</div>
