
@model IEnumerable<RefrigeracionControl.Domain.Entities.RefrigerationEquipment>

@{
    ViewData["Title"] = "Equipos de refrigeración";
}

<div class="dashboard-heading">
    <h2>Equipos de refrigeración</h2>
    <p>Gestión de equipos asociados a los clientes.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="panel-card">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Equipos registrados</h3>

        <a asp-controller="Equipment"
           asp-action="Create"
           class="btn btn-info">
            + Nuevo equipo
        </a>
    </div>

    <form method="get" asp-action="Index" class="row g-2 mb-3">
        <div class="col-md-4"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Equipo, cliente, marca o serie" /></div>
        <div class="col-md-3"><select name="clientId" asp-items="ViewBag.ClientFilter" class="form-select"><option value="">Todos los clientes</option></select></div>
        <div class="col-md-3"><select name="status" class="form-select"><option value="">Todos los estados</option><option value="active" selected="@(ViewData["Status"] as string == "active")">Disponibles</option><option value="inactive" selected="@(ViewData["Status"] as string == "inactive")">No disponibles</option></select></div>
        <div class="col-md-2"><button class="btn btn-info">Filtrar</button> <a asp-action="Index">Limpiar</a></div>
    </form>
    <div class="table-responsive">
        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Equipo</th>
                    <th>Cliente</th>
                    <th>Tipo</th>
                    <th>Marca</th>
                    <th>Modelo</th>
                    <th>N.º de serie</th>
                    <th>Ubicación</th>
                    <th>Estado</th><th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var equipment in Model)
                {
                    <tr>
                        <td>@equipment.Id</td>
                        <td>@equipment.Name</td>
                        <td>@equipment.Client.Name</td>
                        <td>@equipment.EquipmentType</td>
                        <td>@equipment.Brand</td>
                        <td>@equipment.Model</td>
                        <td>@equipment.SerialNumber</td>
                        <td>@equipment.Location</td>
                        <td>
                            @if (equipment.IsActive && equipment.Client.IsActive)
                            {
                                <span class="badge bg-success">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @(equipment.IsActive ? "Cliente inactivo" : "Inactivo")
                                </span>
                            }
                        </td>
                        <td><a asp-action="Details" asp-route-id="@equipment.Id" class="btn btn-sm btn-outline-info">Detalles</a> <a asp-action="Edit" asp-route-id="@equipment.Id" class="btn btn-sm btn-outline-secondary">Editar</a></td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <strong>No se encontraron equipos</strong>
            <p>
                Registra un equipo o ajusta los filtros.
            </p>
        </div>
    }
</div>
